# Supabase Postgres. Both strings come from the same place in the dashboard:
# Project Settings -> Database -> Connection string. Same credentials in both,
# only the port and the pgbouncer flag differ.
#
#   DATABASE_URL  Transaction pooler, port 6543, ?pgbouncer=true&connection_limit=1.
#                 Used by the app at runtime. In serverless lambdas, connection_limit=1
#                 prevents connection pool exhaustion.
#   DIRECT_URL    Session pooler, port 5432, no flag.
#                 Used by `prisma migrate` / `prisma db push` only.
#
# Migrations run against the transaction pooler (6543) hang, because it does
# not support the prepared statements Prisma Migrate needs — keep them split.
DATABASE_URL="postgres://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgres://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Run without a database: sign in against LOCAL_ADMIN_* instead of the Admin
# table, so the app boots before Postgres is set up. Development only — this
# is ignored when NODE_ENV=production. Leave unset for a normal setup.
AUTH_DISABLE_DB="false"
LOCAL_ADMIN_EMAIL="admin@example.com"
LOCAL_ADMIN_PASSWORD="change-this-password"
LOCAL_ADMIN_NAME="Admin"

# Long random string used to sign admin session JWTs
JWT_SECRET="replace-with-a-long-random-secret"

# Public base URL of this deployment (used to build QR verification links)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Initial admin account created by `npm run seed`
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="change-this-password"
SEED_ADMIN_NAME="Admin"

# Supabase Storage — where template images, rendered certificate PDFs and
# batch ZIPs are kept. A serverless deploy has no writable disk that survives
# a request, so these files cannot live on the filesystem.
#
#   SUPABASE_URL               Project Settings -> API -> Project URL
#   SUPABASE_SERVICE_ROLE_KEY  Project Settings -> API -> service_role key.
#                              Server-side only — never expose it to the browser
#                              or prefix it with NEXT_PUBLIC_.
#
# The bucket is private and created automatically on first upload if missing.
SUPABASE_URL="https://[PROJECT-REF].supabase.co"
SUPABASE_SERVICE_ROLE_KEY="replace-with-service-role-key"
SUPABASE_STORAGE_BUCKET="encertify"
